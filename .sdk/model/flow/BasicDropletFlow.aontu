# BasicDropletFlow

main: kit: flow: BasicDropletFlow:
{
  entity: "droplet",
  kind: "basic",
  name: "BasicDropletFlow",
  step: [
    {
      i: {
        ref: "droplet_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "droplet_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "droplet_ref01",
        srcdatavar: "droplet_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-droplet_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "droplet_ref01",
        suffix: "_rm0"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "droplet_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDropletFlow"
}