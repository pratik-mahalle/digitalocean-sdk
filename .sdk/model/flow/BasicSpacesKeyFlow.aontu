# BasicSpacesKeyFlow

main: kit: flow: BasicSpacesKeyFlow:
{
  entity: "spaces_key",
  kind: "basic",
  name: "BasicSpacesKeyFlow",
  step: [
    {
      i: {
        ref: "spaces_key_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "spaces_key_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "spaces_key_ref01",
        srcdatavar: "spaces_key_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-spaces_key_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "spaces_key_ref01",
        srcdatavar: "spaces_key_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "spaces_key01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-spaces_key_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "spaces_key_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "spaces_key01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "spaces_key_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSpacesKeyFlow"
}