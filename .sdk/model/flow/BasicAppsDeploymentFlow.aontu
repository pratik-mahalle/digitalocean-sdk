# BasicAppsDeploymentFlow

main: kit: flow: BasicAppsDeploymentFlow:
{
  entity: "apps_deployment",
  kind: "basic",
  name: "BasicAppsDeploymentFlow",
  step: [
    {
      i: {
        ref: "apps_deployment_ref01"
      }

      m: {
        app_id: "app01"
      }

      o: "create"
    }

    {
      m: {
        app_id: "app01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "apps_deployment_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "apps_deployment_ref01",
        srcdatavar: "apps_deployment_ref01_data",
        suffix: "_dt0"
      }

      m: {
        app_id: "app01",
        id: "apps_deployment01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-apps_deployment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAppsDeploymentFlow"
}