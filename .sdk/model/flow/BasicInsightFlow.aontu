# BasicInsightFlow

main: kit: flow: BasicInsightFlow:
{
  entity: "insight",
  kind: "basic",
  name: "BasicInsightFlow",
  step: [
    {
      i: {
        ref: "insight_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "insight_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "insight_ref01",
        srcdatavar: "insight_ref01_data",
        suffix: "_up0",
        textfield: "last_notified_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-insight_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "insight_ref01",
        srcdatavar: "insight_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "insight01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-insight_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "insight_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "insight01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "insight_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicInsightFlow"
}