# BasicAccessPointFlow

main: kit: flow: BasicAccessPointFlow:
{
  entity: "access_point",
  kind: "basic",
  name: "BasicAccessPointFlow",
  step: [
    {
      i: {
        ref: "access_point_ref01"
      }

      m: {
        share_id: "share01"
      }

      o: "create"
    }

    {
      m: {
        share_id: "share01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "access_point_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "access_point_ref01",
        srcdatavar: "access_point_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "access_point01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-access_point_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "access_point_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "access_point01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        share_id: "share01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "access_point_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAccessPointFlow"
}