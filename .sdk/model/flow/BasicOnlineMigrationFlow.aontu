# BasicOnlineMigrationFlow

main: kit: flow: BasicOnlineMigrationFlow:
{
  entity: "online_migration",
  kind: "basic",
  name: "BasicOnlineMigrationFlow",
  step: [
    {
      i: {
        ref: "online_migration_ref01",
        srcdatavar: "online_migration_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-online_migration_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "online_migration_ref01",
        srcdatavar: "online_migration_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "online_migration01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-online_migration_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicOnlineMigrationFlow"
}