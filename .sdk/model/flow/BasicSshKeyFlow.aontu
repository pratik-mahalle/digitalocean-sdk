# BasicSshKeyFlow

main: kit: flow: BasicSshKeyFlow:
{
  entity: "ssh_key",
  kind: "basic",
  name: "BasicSshKeyFlow",
  step: [
    {
      i: {
        ref: "ssh_key_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "ssh_key_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "ssh_key_ref01",
        srcdatavar: "ssh_key_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ssh_key_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "ssh_key_ref01",
        srcdatavar: "ssh_key_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "ssh_key01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ssh_key_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "ssh_key_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "ssh_key01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "ssh_key_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSshKeyFlow"
}