# BasicCertificateFlow

main: kit: flow: BasicCertificateFlow:
{
  entity: "certificate",
  kind: "basic",
  name: "BasicCertificateFlow",
  step: [
    {
      i: {
        ref: "certificate_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "certificate_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "certificate_ref01",
        srcdatavar: "certificate_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "certificate01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-certificate_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "certificate_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "certificate01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "certificate_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCertificateFlow"
}