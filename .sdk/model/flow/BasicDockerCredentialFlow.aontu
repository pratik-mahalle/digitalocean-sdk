# BasicDockerCredentialFlow

main: kit: flow: BasicDockerCredentialFlow:
{
  entity: "docker_credential",
  kind: "basic",
  name: "BasicDockerCredentialFlow",
  step: [
    {
      i: {
        ref: "docker_credential_ref01",
        srcdatavar: "docker_credential_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-docker_credential_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDockerCredentialFlow"
}