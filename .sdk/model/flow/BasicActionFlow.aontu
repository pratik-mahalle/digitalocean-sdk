  name: "BasicActionFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "action_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "action_ref01",
        srcdatavar: "action_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "action01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-action_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicActionFlow"
