# BasicNfsFlow

main: kit: flow: BasicNfsFlow:
{
  entity: "nfs",
  kind: "basic",
  name: "BasicNfsFlow",
  step: [
    {
      i: {
        ref: "nfs_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "nfs_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "nfs_ref01",
        srcdatavar: "nfs_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "nfs01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-nfs_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "nfs_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "nfs01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "nfs_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicNfsFlow"
}