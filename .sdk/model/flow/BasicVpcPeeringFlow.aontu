  name: "BasicVpcPeeringFlow",
  step: [
    {
      i: {
        ref: "vpc_peering_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "vpc_peering_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "vpc_peering_ref01",
        srcdatavar: "vpc_peering_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-vpc_peering_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "vpc_peering_ref01",
        srcdatavar: "vpc_peering_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "vpc_peering01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-vpc_peering_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "vpc_peering_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "vpc_peering01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "vpc_peering_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicVpcPeeringFlow"
