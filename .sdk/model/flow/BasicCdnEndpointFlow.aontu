# BasicCdnEndpointFlow

main: kit: flow: BasicCdnEndpointFlow:
{
  entity: "cdn_endpoint",
  kind: "basic",
  name: "BasicCdnEndpointFlow",
  step: [
    {
      i: {
        ref: "cdn_endpoint_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "cdn_endpoint_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "cdn_endpoint_ref01",
        srcdatavar: "cdn_endpoint_ref01_data",
        suffix: "_up0",
        textfield: "certificate_id"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-cdn_endpoint_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "cdn_endpoint_ref01",
        srcdatavar: "cdn_endpoint_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "cdn_endpoint01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-cdn_endpoint_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "cdn_endpoint_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "cdn_endpoint01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "cdn_endpoint_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCdnEndpointFlow"
}