# Entity: insight

main: kit: entity: insight: {

  alias: field: {}

  fields: {
    channel_type: {
      h: "Channel Type"
      n: "channel_type"
      r: true
      ro: true
      sh: "The configured channel type."
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      ro: true
      sh: "Time the alert rule was created."
      t: "`$STRING`"
    }
    email: {
      h: "Email"
      n: "email"
      r: true
      sh: "Email notification channel configuration."
      t: "`$OBJECT`"
    }
    id: {
      fo: "uuid"
      h: "Id"
      n: "id"
      r: true
      ro: true
      sh: "A unique identifier for the alert instance."
      t: "`$STRING`"
    }
    last_notified_at: {
      fo: "date-time"
      h: "Last Notified At"
      n: "last_notified_at"
      r: false
      sh: "Time a notification was last sent for this alert instance."
      t: "`$STRING`"
    }
    last_triggered_at: {
      fo: "date-time"
      h: "Last Triggered At"
      n: "last_triggered_at"
      r: true
      sh: "Time the alert instance most recently fired."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "A human-readable name for the notification channel."
      t: "`$STRING`"
    }
    resolved_at: {
      fo: "date-time"
      h: "Resolved At"
      n: "resolved_at"
      r: false
      sh: "Time the alert instance resolved."
      t: "`$STRING`"
    }
    resource_urn: {
      h: "Resource Urn"
      n: "resource_urn"
      r: false
      sh: "URN of the DigitalOcean resource the alert fired for."
      t: "`$STRING`"
    }
    rule_id: {
      fo: "uuid"
      h: "Rule Id"
      n: "rule_id"
      r: true
      sh: "ID of the alert rule that fired this alert instance."
      t: "`$STRING`"
    }
    severity: {
      h: "Severity"
      n: "severity"
      r: true
      sh: "Severity of the breached threshold."
      t: "`$STRING`"
    }
    slack: {
      h: "Slack"
      n: "slack"
      r: true
      sh: "Slack notification channel configuration as returned in API responses."
      t: "`$OBJECT`"
    }
    spec: {
      h: "Spec"
      n: "spec"
      r: true
      sh: "Spec for an Insights alert rule."
      t: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    status: {
      h: "Status"
      n: "status"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      ro: true
      sh: "Current status of the alert instance."
      t: "`$STRING`"
    }
    triggered_at: {
      fo: "date-time"
      h: "Triggered At"
      n: "triggered_at"
      r: true
      sh: "Time the alert instance first fired."
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      ro: true
      sh: "Time the alert rule was last updated."
      t: "`$STRING`"
    }
    usage: {
      h: "Usage"
      n: "usage"
      r: false
      ro: true
      t: "`$ANY`"
    }
    value: {
      fo: "double"
      h: "Value"
      n: "value"
      r: true
      sh: "The observed metric value that breached the threshold."
      t: "`$NUMBER`"
    }
    webhook: {
      h: "Webhook"
      n: "webhook"
      r: true
      sh: "Generic HTTPS webhook notification channel configuration as returned in API responses."
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "insight"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /v2/insights/alert-rules"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/v2/insights/alert-rules"
          q: {
            "$action": "alert_rule"
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "insights"
            }
            {
              lit: "alert-rules"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.alert_rule`"
          }
        }
        {
          co: {
            id: "POST /v2/insights/notification-channels"
            source: "openapi3"
            version: 2
          }
