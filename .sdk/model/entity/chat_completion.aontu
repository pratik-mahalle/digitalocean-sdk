# Entity: chat_completion

main: kit: entity: chat_completion: {

  alias: field: {}

  fields: {
    choices: {
      h: "Choices"
      n: "choices"
      r: true
      sh: "A list of chat completion choices."
      t: "`$ARRAY`"
    }
    created: {
      h: "Created"
      n: "created"
      r: true
      sh: "The Unix timestamp (in seconds) of when the chat completion was created."
      t: "`$INTEGER`"
    }
    frequency_penalty: {
      h: "Frequency Penalty"
      n: "frequency_penalty"
      r: false
      sh: "Number between -2.0 and 2.0."
      t: "`$NUMBER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "A unique identifier for the chat completion."
      t: "`$STRING`"
    }
    logit_bias: {
      h: "Logit Bias"
      n: "logit_bias"
      r: false
      sh: "Modify the likelihood of specified tokens appearing in the completion."
      t: "`$OBJECT`"
    }
    logprobs: {
      h: "Logprobs"
      n: "logprobs"
      r: false
      sh: "Whether to return log probabilities of the output tokens or not."
      t: "`$BOOLEAN`"
    }
    max_completion_tokens: {
      h: "Max Completion Tokens"
      n: "max_completion_tokens"
      r: false
      sh: "The maximum number of completion tokens that may be used over the course of the run."
      t: "`$INTEGER`"
    }
    max_tokens: {
      h: "Max Tokens"
      n: "max_tokens"
      r: false
      sh: "The maximum number of tokens that can be generated in the completion."
      t: "`$INTEGER`"
    }
    messages: {
      h: "Messages"
      n: "messages"
      r: true
      sh: "A list of messages comprising the conversation so far."
      t: "`$ARRAY`"
    }
    metadata: {
      h: "Metadata"
      n: "metadata"
      r: false
      sh: "Set of 16 key-value pairs that can be attached to an object."
      t: "`$OBJECT`"
    }
    model: {
      h: "Model"
      n: "model"
      r: true
      sh: "The model used for the chat completion."
      t: "`$STRING`"
    }
    n: {
      h: "N"
      n: "n"
      r: false
      sh: "How many chat completion choices to generate for each input message."
      t: "`$INTEGER`"
    }
    object: {
      h: "Object"
      n: "object"
      r: true
      sh: "The object type, which is always chat.completion."
      t: "`$STRING`"
    }
    presence_penalty: {
      h: "Presence Penalty"
      n: "presence_penalty"
      r: false
      sh: "Number between -2.0 and 2.0."
      t: "`$NUMBER`"
    }
    reasoning_effort: {
      h: "Reasoning Effort"
      n: "reasoning_effort"
      r: false
      sh: "Constrains effort on reasoning for reasoning models."
      t: "`$STRING`"
    }
    seed: {
      h: "Seed"
      n: "seed"
      r: false
      sh: "If specified, the system will make a best effort to sample deterministically, such that repeated requests with the same seed and parameters should return the same result."
      t: "`$INTEGER`"
    }
    stop: {
      h: "Stop"
      n: "stop"
      r: false
      sh: "Up to 4 sequences where the API will stop generating further tokens."
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    stream: {
      h: "Stream"
      n: "stream"
      r: false
      sh: "If set to true, the model response data will be streamed to the client as it is generated using server-sent events."
      t: "`$BOOLEAN`"
    }
    stream_options: {
      h: "Stream Options"
      n: "stream_options"
      r: false
      sh: "Options for streaming response."
      t: "`$OBJECT`"
    }
    temperature: {
      h: "Temperature"
      n: "temperature"
      r: false
      sh: "What sampling temperature to use, between 0 and 2."
      t: "`$NUMBER`"
    }
    tool_choice: {
      h: "Tool Choice"
      n: "tool_choice"
      r: false
      sh: "Controls which (if any) tool is called by the model."
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    tools: {
      h: "Tools"
      n: "tools"
      r: false
      sh: "A list of tools the model may call."
      t: "`$ARRAY`"
    }
    top_logprobs: {
      h: "Top Logprobs"
      n: "top_logprobs"
      r: false
      sh: "An integer between 0 and 20 specifying the number of most likely tokens to return at each token position, each with an associated log probability."
      t: "`$INTEGER`"
    }
    top_p: {
      h: "Top P"
      n: "top_p"
      r: false
      sh: "An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass."
      t: "`$NUMBER`"
    }
    usage: {
      h: "Usage"
      n: "usage"
      r: true
      sh: "Usage statistics for the completion request."
      t: "`$OBJECT`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      sh: "A unique identifier representing your end-user, which can help DigitalOcean to monitor and detect abuse."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "chat_completion"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /api/v1/chat/completions"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: true
                k: "query"
                n: "agent"
                or: "agent"
                r: true
                t: "`$BOOLEAN`"
              }
            ]
          }
          m: "POST"
          o: "/api/v1/chat/completions"
          q: {
            exist: [
              "agent"
            ]
          }
          rs: {
            alternatives: [
              {
                kind: "raw"
                media: "text/event-stream"
              }
            ]
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "chat"
            }
            {
              lit: "completions"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /v1/chat/completions"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/v1/chat/completions"
          rs: {
            alternatives: [
              {
                kind: "raw"
                media: "text/event-stream"
              }
            ]
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "chat"
            }
            {
              lit: "completions"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
