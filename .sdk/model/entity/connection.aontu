# Entity: connection

main: kit: entity: connection: {

  alias: field: {}

  fields: {
    api_key: {
      h: "Api Key"
      n: "api_key"
      r: false
      sh: "Set for `team_api_key` connections."
      t: "`$OBJECT`"
    }
    authorization: {
      h: "Authorization"
      n: "authorization"
      r: false
      sh: "Present only while the connection is pending and you created it."
      t: "`$ANY`"
    }
    connection: {
      h: "Connection"
      n: "connection"
      r: false
      sh: "The connection."
      t: "`$ANY`"
    }
    connection_parameters: {
      h: "Connection Parameters"
      n: "connection_parameters"
      r: false
      sh: "Values for the provider's `connection_parameters`, validated against their specifications."
      t: "`$OBJECT`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: false
      sh: "When the connection was created."
      t: "`$STRING`"
    }
    credential: {
      h: "Credential"
      n: "credential"
      r: false
      sh: "Optional credential to connect through."
      t: "`$OBJECT`"
    }
    credential_id: {
      h: "Credential Id"
      n: "credential_id"
      r: false
      sh: "Empty for `digitalocean_oauth`; otherwise the ID of the team provider credential the connection uses."
      t: "`$STRING`"
    }
    credential_kind: {
      h: "Credential Kind"
      n: "credential_kind"
      r: false
      sh: "`digitalocean_oauth`, `private_oauth`, or `team_api_key`."
      t: "`$STRING`"
    }
    granted_at: {
      de: true
      fo: "date-time"
      h: "Granted At"
      n: "granted_at"
      r: false
      sh: "Deprecated: read `oauth.granted_at`."
      t: "`$STRING`"
    }
    id: {
      fo: "uuid"
      h: "Id"
      n: "id"
      r: false
      sh: "Opaque connection ID."
      t: "`$STRING`"
    }
    network: {
      h: "Network"
      n: "network"
      r: false
      sh: "Optional private network for the connection's calls."
      t: "`$OBJECT`"
    }
    oauth: {
      h: "Oauth"
      n: "oauth"
      r: false
      sh: "Set for `digitalocean_oauth` and `private_oauth` connections."
      t: "`$OBJECT`"
    }
    owning_user_id: {
      h: "Owning User Id"
      n: "owning_user_id"
      r: false
      sh: "DigitalOcean user ID of the user who created the connection, when recorded."
      t: "`$STRING`"
    }
    provider: {
      h: "Provider"
      n: "provider"
      op: {
        list: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Required provider slug, from the provider list."
      t: "`$STRING`"
    }
    provider_display_name: {
      h: "Provider Display Name"
      n: "provider_display_name"
      r: false
      sh: "Human-readable provider name, for example `Jira`."
      t: "`$STRING`"
    }
    revoked_at: {
      fo: "date-time"
      h: "Revoked At"
      n: "revoked_at"
      r: false
      sh: "When the connection was revoked."
      t: "`$STRING`"
    }
    scopes: {
      de: true
      h: "Scopes"
      n: "scopes"
      r: false
      sh: "Optional OAuth scopes to request."
      t: "`$ARRAY`"
    }
    status: {
      h: "Status"
      n: "status"
      r: false
      sh: "pending, active, revoked, or expired."
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: false
      sh: "When the connection was last modified."
      t: "`$STRING`"
    }
    user_id: {
      h: "User Id"
      n: "user_id"
      op: {
        list: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Required."
      t: "`$STRING`"
    }
  }

