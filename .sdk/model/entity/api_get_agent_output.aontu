  name: "api_get_agent_output"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v2/gen-ai/agents/{uuid}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "\"123e4567-e89b-12d3-a456-426614174000\""
                k: "param"
                n: "uuid"
                or: "uuid"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v2/gen-ai/agents/{uuid}"
          q: {
            exist: [
              "uuid"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "gen-ai"
            }
            {
              lit: "agents"
            }
            {
              var: "uuid"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.agent`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "PUT /v2/gen-ai/agents/{uuid}/deployment_visibility"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "\"123e4567-e89b-12d3-a456-426614174000\""
                k: "param"
                n: "uuid"
                or: "uuid"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "PUT"
          o: "/v2/gen-ai/agents/{uuid}/deployment_visibility"
          q: {
            "$action": "deployment_visibility"
            exist: [
              "uuid"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "gen-ai"
            }
            {
              lit: "agents"
            }
            {
              var: "uuid"
            }
            {
              lit: "deployment_visibility"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.agent`"
          }
        }
      ]
    }
