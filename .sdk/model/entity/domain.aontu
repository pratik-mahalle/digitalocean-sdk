# Entity: domain

main: kit: entity: domain: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    ip_address: {
      h: "Ip Address"
      n: "ip_address"
      r: false
      sh: "This optional attribute may contain an IP address."
      t: "`$STRING`"
      wo: true
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name of the domain itself."
      t: "`$STRING`"
    }
    ttl: {
      h: "Ttl"
      n: "ttl"
      r: false
      ro: true
      sh: "This value is the time to live for the records on this domain, in seconds."
      t: "`$INTEGER`"
    }
    zone_file: {
      h: "Zone File"
      n: "zone_file"
      r: false
      ro: true
      sh: "This attribute contains the complete contents of the zone file for the selected domain."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "domain"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /v2/domains"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/v2/domains"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "domains"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.domain`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v2/domains"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 2
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/v2/domains"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "domains"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.domains`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v2/domains/{domain_name}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "example.com"
                k: "param"
                n: "id"
                or: "domain_name"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v2/domains/{domain_name}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              domain_name: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "domains"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.domain`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "DELETE /v2/domains/{domain_name}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "example.com"
                k: "param"
                n: "id"
                or: "domain_name"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "DELETE"
          o: "/v2/domains/{domain_name}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              domain_name: "id"
            }
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "domains"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
