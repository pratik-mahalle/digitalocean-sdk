# Entity: size

main: kit: entity: size: {

  alias: field: {}

  fields: {
    available: {
      h: "Available"
      n: "available"
      r: true
      sh: "This is a boolean value that represents whether new Droplets can be created with this size."
      t: "`$BOOLEAN`"
    }
    description: {
      h: "Description"
      n: "description"
      r: true
      sh: "A string describing the class of Droplets created from this size."
      t: "`$STRING`"
    }
    disk: {
      h: "Disk"
      n: "disk"
      r: true
      sh: "The amount of disk space set aside for Droplets of this size."
      t: "`$INTEGER`"
    }
    disk_info: {
      h: "Disk Info"
      n: "disk_info"
      r: false
      sh: "An array of objects containing information about the disks available to Droplets created with this size."
      t: "`$ARRAY`"
    }
    gpu_info: {
      h: "Gpu Info"
      n: "gpu_info"
      r: false
      sh: "An object containing information about the GPU capabilities of Droplets created with this size."
      t: "`$OBJECT`"
    }
    memory: {
      h: "Memory"
      n: "memory"
      r: true
      sh: "The amount of RAM allocated to Droplets created of this size."
      t: "`$INTEGER`"
    }
    price_hourly: {
      fo: "float"
      h: "Price Hourly"
      n: "price_hourly"
      r: true
      sh: "This describes the price of the Droplet size as measured hourly."
      t: "`$NUMBER`"
    }
    price_monthly: {
      fo: "float"
      h: "Price Monthly"
      n: "price_monthly"
      r: true
      sh: "This attribute describes the monthly cost of this Droplet size if the Droplet is kept for an entire month."
      t: "`$NUMBER`"
    }
    regions: {
      h: "Regions"
      n: "regions"
      r: true
      sh: "An array containing the region slugs where this size is available for Droplet creates."
      t: "`$ARRAY`"
    }
    slug: {
      h: "Slug"
      n: "slug"
      r: true
      sh: "A human-readable string that is used to uniquely identify each size."
      t: "`$STRING`"
    }
    transfer: {
      fo: "float"
      h: "Transfer"
      n: "transfer"
      r: true
      sh: "The amount of transfer bandwidth that is available for Droplets created in this size."
      t: "`$NUMBER`"
    }
    vcpus: {
      h: "Vcpus"
      n: "vcpus"
      r: true
      sh: "The number of CPUs allocated to Droplets of this size."
      t: "`$INTEGER`"
    }
  }

  name: "size"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v2/sizes"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 2
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/v2/sizes"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "sizes"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.sizes`"
          }
        }
      ]
    }
  }



}
