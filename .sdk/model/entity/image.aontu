      h: "Min Disk Size"
      n: "min_disk_size"
      r: false
      sh: "The minimum disk size in GB required for a Droplet to use this image."
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "The display name that has been given to an image."
      t: "`$STRING`"
    }
    public: {
      h: "Public"
      n: "public"
      r: false
      sh: "This is a boolean value that indicates whether the image in question is public or not."
      t: "`$BOOLEAN`"
    }
    region: {
      h: "Region"
      n: "region"
      r: true
      sh: "The slug identifier for the region where the resource will initially be available."
      t: "`$STRING`"
    }
    regions: {
      h: "Regions"
      n: "regions"
      r: false
      sh: "This attribute is an array of the regions that the image is available in."
      t: "`$ARRAY`"
    }
    size_gigabytes: {
      fo: "float"
      h: "Size Gigabytes"
      n: "size_gigabytes"
      r: false
      sh: "The size of the image in gigabytes."
      t: "`$NUMBER`"
    }
