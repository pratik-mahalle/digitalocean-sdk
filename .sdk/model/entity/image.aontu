    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "Describes the kind of image."
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "A URL from which the custom Linux virtual machine image may be retrieved."
      t: "`$STRING`"
    }
