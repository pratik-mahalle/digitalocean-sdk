          }
          m: "GET"
          o: "/v2/customers/my/invoices/{invoice_uuid}/csv"
          q: {
            exist: [
              "invoice_uuid"
            ]
          }
          rs: {
            kind: "raw"
            media: "text/csv"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "customers"
            }
            {
              lit: "my"
            }
            {
              lit: "invoices"
            }
            {
