# Entity: model

main: kit: entity: model: {

  alias: field: {}

  fields: {
    created: {
      h: "Created"
      n: "created"
      r: true
      sh: "The Unix timestamp (in seconds) when the model was created."
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The model identifier, which can be referenced in the API endpoints."
      t: "`$STRING`"
    }
    object: {
      h: "Object"
      n: "object"
      r: true
      sh: "The object type, which is always \"model\"."
      t: "`$STRING`"
    }
    owned_by: {
      h: "Owned By"
      n: "owned_by"
      r: true
      sh: "The organization that owns the model."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "model"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/models"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/v1/models"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "models"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
