# Entity: function

main: kit: entity: function: {

  alias: field: {}

  fields: {
    api_host: {
      h: "Api Host"
      n: "api_host"
      r: false
      sh: "The namespace's API hostname."
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: false
      ro: true
      sh: "UTC time string."
      t: "`$STRING`"
    }
    expires_at: {
      fo: "date-time"
      h: "Expires At"
      n: "expires_at"
      r: false
      ro: true
      sh: "When the key expires (null for non-expiring keys)."
      t: "`$STRING`"
    }
    expires_in: {
      h: "Expires In"
      n: "expires_in"
      r: false
      sh: "The duration after which the access key expires, specified as a human-readable duration string in the format `<int>h` (hours) or `<int>d` (days)."
      t: "`$STRING`"
    }
    function: {
      h: "Function"
      n: "function"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "Name of function(action) that exists in the given namespace."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      ro: true
      sh: "The access key's unique identifier with prefix 'dof_v1_'."
      t: "`$STRING`"
    }
    is_enabled: {
      h: "Is Enabled"
      n: "is_enabled"
      op: {
        create: {
          req: true
          type: "`$BOOLEAN`"
        }
      }
      r: false
      sh: "Indicates weather the trigger is paused or unpaused."
      t: "`$BOOLEAN`"
    }
    key: {
      h: "Key"
      n: "key"
      r: false
      sh: "A random alpha numeric string."
      t: "`$STRING`"
    }
    label: {
      h: "Label"
      n: "label"
      r: false
      sh: "The namespace's unique name."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
        update: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "The trigger's unique name within the namespace."
      t: "`$STRING`"
    }
    namespace: {
      h: "Namespace"
      n: "namespace"
      r: false
      sh: "A unique string format of UUID with a prefix fn-."
      t: "`$STRING`"
    }
    region: {
      h: "Region"
      n: "region"
      r: false
      sh: "The namespace's datacenter region."
      t: "`$STRING`"
    }
    scheduled_details: {
      h: "Scheduled Details"
      n: "scheduled_details"
      r: true
      sh: "Trigger details for SCHEDULED type, where body is optional."
      t: "`$OBJECT`"
    }
    scheduled_runs: {
      h: "Scheduled Runs"
      n: "scheduled_runs"
      r: false
      t: "`$OBJECT`"
    }
    type: {
      h: "Type"
      n: "type"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "String which indicates the type of trigger source like SCHEDULED."
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: false
      ro: true
      sh: "UTC time string."
      t: "`$STRING`"
    }
    uuid: {
      h: "Uuid"
      n: "uuid"
      r: false
      sh: "The namespace's Universally Unique Identifier."
      t: "`$STRING`"
    }
  }

