# Entity: credential

main: kit: entity: credential: {

  alias: field: {}

  fields: {
    certificate_authority_data: {
      fo: "byte"
      h: "Certificate Authority Data"
      n: "certificate_authority_data"
      r: false
      sh: "A base64 encoding of bytes representing the certificate authority data for accessing the cluster."
      t: "`$STRING`"
    }
    client_certificate_data: {
      de: true
      fo: "byte"
      h: "Client Certificate Data"
      n: "client_certificate_data"
      r: false
      sh: "A base64 encoding of bytes representing the x509 client certificate data for access the cluster."
      t: "`$STRING`"
    }
    client_key_data: {
      de: true
      fo: "byte"
      h: "Client Key Data"
      n: "client_key_data"
      r: false
      sh: "A base64 encoding of bytes representing the x509 client key data for access the cluster."
      t: "`$STRING`"
    }
    expires_at: {
      fo: "date-time"
      h: "Expires At"
      n: "expires_at"
      r: false
      sh: "A time value given in ISO8601 combined date and time format that represents when the access token expires."
      t: "`$STRING`"
    }
    server: {
      fo: "uri"
      h: "Server"
      n: "server"
      r: false
      sh: "The URL used to access the cluster API server."
      t: "`$STRING`"
    }
    token: {
      h: "Token"
      n: "token"
      r: false
      sh: "An access token used to authenticate with the cluster."
      t: "`$STRING`"
    }
  }

  name: "credential"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v2/kubernetes/clusters/{cluster_id}/credentials"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "bd5f5959-5e1e-4205-a714-a914373942af"
                k: "param"
                n: "cluster_id"
                or: "cluster_id"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: 300
                k: "query"
                n: "expiry_second"
                or: "expiry_seconds"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/v2/kubernetes/clusters/{cluster_id}/credentials"
          q: {
            exist: [
              "cluster_id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "kubernetes"
            }
            {
              lit: "clusters"
            }
            {
              var: "cluster_id"
            }
            {
              lit: "credentials"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
