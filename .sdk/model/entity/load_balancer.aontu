# Entity: load_balancer

main: kit: entity: load_balancer: {

  alias: field: {}

  fields: {
    algorithm: {
      de: true
      h: "Algorithm"
      n: "algorithm"
      r: false
      sh: "This field has been deprecated."
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: false
      ro: true
      sh: "A time value given in ISO8601 combined date and time format that represents when the load balancer was created."
      t: "`$STRING`"
    }
    disable_lets_encrypt_dns_records: {
      h: "Disable Lets Encrypt Dns Records"
      n: "disable_lets_encrypt_dns_records"
      r: false
      sh: "A boolean value indicating whether to disable automatic DNS record creation for Let's Encrypt certificates that are added to the load balancer."
      t: "`$BOOLEAN`"
    }
    domains: {
      h: "Domains"
      n: "domains"
      r: false
      sh: "An array of objects specifying the domain configurations for a Global load balancer."
      t: "`$ARRAY`"
    }
    droplet_ids: {
      h: "Droplet Ids"
      n: "droplet_ids"
      r: false
      sh: "An array containing the IDs of the Droplets assigned to the load balancer."
      t: "`$ARRAY`"
    }
    enable_backend_keepalive: {
      h: "Enable Backend Keepalive"
      n: "enable_backend_keepalive"
      r: false
      sh: "A boolean value indicating whether HTTP keepalive connections are maintained to target Droplets."
      t: "`$BOOLEAN`"
    }
    enable_proxy_protocol: {
      h: "Enable Proxy Protocol"
      n: "enable_proxy_protocol"
      r: false
      sh: "A boolean value indicating whether PROXY Protocol is in use."
      t: "`$BOOLEAN`"
    }
    firewall: {
      h: "Firewall"
      n: "firewall"
      r: false
      sh: "An object specifying allow and deny rules to control traffic to the load balancer."
      t: "`$OBJECT`"
    }
    forwarding_rules: {
      h: "Forwarding Rules"
      n: "forwarding_rules"
      r: true
      sh: "An array of objects specifying the forwarding rules for a load balancer."
      t: "`$ARRAY`"
    }
    glb_settings: {
      h: "Glb Settings"
      n: "glb_settings"
      r: false
      sh: "An object specifying forwarding configurations for a Global load balancer."
      t: "`$OBJECT`"
    }
    health_check: {
      h: "Health Check"
      n: "health_check"
      r: false
      sh: "An object specifying health check settings for the load balancer."
      t: "`$OBJECT`"
    }
    http_idle_timeout_seconds: {
      h: "Http Idle Timeout Seconds"
      n: "http_idle_timeout_seconds"
      r: false
      sh: "An integer value which configures the idle timeout for HTTP requests to the target droplets."
      t: "`$INTEGER`"
    }
    id: {
      fo: "uuid"
      h: "Id"
      n: "id"
      r: false
      ro: true
      sh: "A unique ID that can be used to identify and reference a load balancer."
      t: "`$STRING`"
    }
    ip: {
      h: "Ip"
      n: "ip"
      r: false
      ro: true
      sh: "An attribute containing the public-facing IP address of the load balancer."
      t: "`$STRING`"
    }
    ipv6: {
      h: "Ipv6"
      n: "ipv6"
      r: false
      ro: true
      sh: "An attribute containing the public-facing IPv6 address of the load balancer."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "A human-readable name for a load balancer instance."
      t: "`$STRING`"
    }
    network: {
      h: "Network"
      n: "network"
      r: false
      sh: "A string indicating whether the load balancer should be external or internal."
      t: "`$STRING`"
    }
    network_stack: {
      h: "Network Stack"
      n: "network_stack"
      r: false
      sh: "A string indicating whether the load balancer will support IPv4 or both IPv4 and IPv6 networking."
      t: "`$STRING`"
    }
    project_id: {
      h: "Project Id"
      n: "project_id"
      r: false
      sh: "The ID of the project that the load balancer is associated with."
      t: "`$STRING`"
    }
    redirect_http_to_https: {
      h: "Redirect Http To Https"
      n: "redirect_http_to_https"
      r: false
      sh: "A boolean value indicating whether HTTP requests to the load balancer on port 80 will be redirected to HTTPS on port 443."
      t: "`$BOOLEAN`"
    }
    region: {
      h: "Region"
      n: "region"
      r: false
      t: "`$OBJECT`"
    }
    size: {
      de: true
      h: "Size"
      n: "size"
      r: false
      sh: "This field has been replaced by the `size_unit` field for all regions except in AMS2, NYC2, and SFO1."
      t: "`$STRING`"
    }
    size_unit: {
      h: "Size Unit"
      n: "size_unit"
      r: false
      sh: "How many nodes the load balancer contains."
      t: "`$INTEGER`"
    }
    status: {
      h: "Status"
      n: "status"
      r: false
      ro: true
      sh: "A status string indicating the current state of the load balancer."
      t: "`$STRING`"
    }
    sticky_sessions: {
      h: "Sticky Sessions"
      n: "sticky_sessions"
      r: false
      sh: "An object specifying sticky sessions settings for the load balancer."
      t: "`$OBJECT`"
    }
    subnet_uuid: {
      fo: "uuid"
      h: "Subnet Uuid"
      n: "subnet_uuid"
      r: false
      sh: "A string specifying the UUID of the VPC subnet to which the load balancer is assigned."
      t: "`$STRING`"
    }
    tag: {
      h: "Tag"
      n: "tag"
      r: false
      sh: "The name of a Droplet tag corresponding to Droplets assigned to the load balancer."
      t: "`$STRING`"
    }
    target_load_balancer_ids: {
      h: "Target Load Balancer Ids"
      n: "target_load_balancer_ids"
      r: false
      sh: "An array containing the UUIDs of the Regional load balancers to be used as target backends for a Global load balancer."
      t: "`$ARRAY`"
    }
    tls_cipher_policy: {
      h: "Tls Cipher Policy"
      n: "tls_cipher_policy"
      r: false
      sh: "A string indicating the policy for the TLS cipher suites used by the load balancer."
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "A string indicating whether the load balancer should be a standard regional HTTP load balancer, a regional network load balancer that routes traffic at the TCP/UDP transport layer, or a global load balancer."
      t: "`$STRING`"
    }
    vpc_uuid: {
      fo: "uuid"
      h: "Vpc Uuid"
      n: "vpc_uuid"
      r: false
      sh: "A string specifying the UUID of the VPC to which the load balancer is assigned."
      t: "`$STRING`"
    }
  }

