# Entity: api_update_simulation_run_output

main: kit: entity: api_update_simulation_run_output: {

  alias: field: {}

  fields: {
    agent_config: {
      h: "Agent Config"
      n: "agent_config"
      r: false
      sh: "Configuration of the candidate agent under test for a simulation run."
