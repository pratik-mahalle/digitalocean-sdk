      t: "`$OBJECT`"
    }
    run_uuid: {
      h: "Run Uuid"
      n: "run_uuid"
      r: false
      sh: "UUID of the run."
      t: "`$STRING`"
    }
    scenario_count: {
      fo: "int64"
      h: "Scenario Count"
      n: "scenario_count"
      r: false
      sh: "Number of scenarios in the scenario set for this run."
      t: "`$INTEGER`"
    }
    scenario_set_uuid: {
      h: "Scenario Set Uuid"
      n: "scenario_set_uuid"
      r: false
      sh: "UUID of the scenario set being executed (must exist at run create)."
      t: "`$STRING`"
    }
    status: {
      h: "Status"
      n: "status"
      r: false
      sh: "Lifecycle status of a simulation run."
      t: "`$STRING`"
    }
    total_journeys: {
      fo: "int64"
      h: "Total Journeys"
      n: "total_journeys"
      r: false
      sh: "Total number of journeys (sum of exploration budgets)."
