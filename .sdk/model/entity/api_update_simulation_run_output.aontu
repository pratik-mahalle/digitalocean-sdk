    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: false
      sh: "Time last updated at."
      t: "`$STRING`"
    }
    user_simulator_config: {
      h: "User Simulator Config"
      n: "user_simulator_config"
      r: false
